{
  "name": "nuvei-web-ui",
  "version": "0.1.0",
  "description": "Local integration example and evidence harness for the Nuvei commercetools connector",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node mock-commercetools-server.mjs",
    "test:api": "node api-e2e-test.mjs",
    "tunnel:dmn": "node start-dmn-tunnel.mjs",
    "sanitize:evidence": "node scripts/sanitize-evidence.mjs",
    "validate:evidence": "node scripts/validate-evidence.mjs",
    "evidence:self-check": "node scripts/validate-evidence.mjs --self-check",
    "mock:ct:self-check": "node scripts/mock-ct-self-check.mjs",
    "capture:stage-a": "node scripts/capture-stage-a.mjs",
    "capture:stage-b": "node scripts/capture-stage-b.mjs",
    "capture:dmn-proxy": "node scripts/capture-dmn-proxy.mjs",
    "capture:stage-c": "node scripts/capture-stage-c.mjs",
    "capture:real-checkout": "node scripts/capture-real-checkout.mjs",
    "validate:phase-2-gate": "node scripts/capture-real-checkout.mjs --validate",
    "real-checkout:self-check": "node scripts/real-checkout-gate-self-check.mjs",
    "evidence:nuvei": "node scripts/collect-nuvei-side.mjs",
    "evidence:ct": "node scripts/collect-ct-side.mjs",
    "evidence:e2e": "node scripts/collect-e2e.mjs",
    "evidence:all": "node scripts/collect-all-evidence.mjs",
    "evidence:sides-self-check": "node scripts/collect-sides-self-check.mjs"
  },
  "dependencies": {
    "express": "^4.18.3"
  }
}
