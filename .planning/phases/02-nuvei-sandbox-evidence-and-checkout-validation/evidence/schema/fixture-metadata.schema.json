{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2 Fixture Metadata",
  "type": "object",
  "required": [
    "scenarioId",
    "fixtureName",
    "source",
    "sanitizedAt",
    "aliases"
  ],
  "additionalProperties": true,
  "properties": {
    "scenarioId": {
      "type": "string",
      "pattern": "^NUV-0[1-8]-"
    },
    "fixtureName": {
      "type": "string"
    },
    "source": {
      "enum": [
        "raw-workspace",
        "manual-note",
        "derived-synthetic"
      ]
    }
  }
}
