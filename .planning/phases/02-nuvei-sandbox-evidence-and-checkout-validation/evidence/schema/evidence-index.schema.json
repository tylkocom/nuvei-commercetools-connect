{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2 Evidence Index",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "rawWorkspace",
    "evidenceRoot",
    "stageOrder",
    "scenarios"
  ],
  "additionalProperties": true,
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenarioFolder",
          "requirements",
          "requiredStage",
          "frontendMode",
          "environment",
          "status",
          "fixtures",
          "aliases",
          "conclusion",
          "blockers",
          "findings"
        ]
      }
    }
  }
}
