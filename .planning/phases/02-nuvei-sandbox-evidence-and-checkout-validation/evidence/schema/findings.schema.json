{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2 Findings",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "findings"
  ],
  "additionalProperties": true,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenarioId",
          "severity",
          "observed",
          "expected",
          "targetPhase",
          "evidenceRefs",
          "status"
        ]
      }
    }
  }
}
